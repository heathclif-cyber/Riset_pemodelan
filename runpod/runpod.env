# =============================================================
# RunPod SSH Configuration
# Isi sesuai info dari RunPod Dashboard → My Pods → Connect
# Klik "SSH over exposed TCP" untuk mendapatkan HOST dan PORT
#
# Format koneksi yang ditampilkan RunPod:
#   ssh root@XXXX.runpod.net -p YYYYY
#          ^^^^^^^^^^^^^^^^       ^^^^^
#          RUNPOD_HOST            RUNPOD_PORT
# =============================================================

RUNPOD_HOST=GANTI_DENGAN_HOST.runpod.net
RUNPOD_PORT=GANTI_DENGAN_PORT
RUNPOD_USER=root

# Opsional: path ke SSH private key
# Kosongkan jika menggunakan password atau jika RunPod menggunakan key default
# Contoh: RUNPOD_SSH_KEY=C:\Users\Bagas\.ssh\id_rsa
RUNPOD_SSH_KEY=

# Direktori kerja di server RunPod (biarkan default)
REMOTE_DIR=/workspace/Riset_pemodelan
